# Generate secrets 

BETTER_AUTH_SECRET=your-better-auth-secret-min-32-chars

# Copy configuration values from habidat-setup/store/auth/auth.env

HABIDAT_STORE_DIR=/home/user/dev/habidat-setup/store

DOCKER_PREFIX=habidat
DOMAIN=habidat.localhost

ADMIN_EMAIL=
ADMIN_PASSWORD=

LDAP_BASE_DN=dc=habidat,dc=localhost
LDAP_BIND_PASSWORD=

# DiscourseConnect shared secret for habidat-auth /sso/discourse (not the Nextcloud plugin)
DISCOURSE_SSO_SECRET=
DISCOURSE_API_KEY=
# HTTP :80 origin Discourse uses to fetch avatars (Docker hostname, not APP_URL)
# DISCOURSE_AVATAR_BASE_URL=http://habidat-user-avatars

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=dev@localhost
# SMTP_USER=
# SMTP_PASS=

